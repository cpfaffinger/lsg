# Copy to .env and adjust. Never commit .env.

# Host port of the single exposed HTTP endpoint (web container).
LSG_HTTP_PORT=8080

# Host address the port binds to. Use 127.0.0.1 when a reverse proxy runs on the same host.
LSG_HTTP_BIND=0.0.0.0

# Secret used to encrypt stored secrets (e.g. the Google client secret) and sign sessions.
# Leave empty to auto-generate one on first start in ./data/secret.key (keep it with your backups).
# Generate manually with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LSG_SECRET_KEY=

# First admin account, created on first start if no admin exists yet.
# Change the password after the first login; these values are ignored afterwards.
LSG_ADMIN_USER=admin
LSG_ADMIN_PASSWORD=

# Optional initial public URL (e.g. https://lsg.example.com).
# The value set in the admin area takes precedence.
LSG_PUBLIC_URL=

# Header that carries the real client IP: cf-connecting-ip (Cloudflare), x-forwarded-for, or none.
LSG_CLIENT_IP_HEADER=cf-connecting-ip
